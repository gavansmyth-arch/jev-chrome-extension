{
  "manifest_version": 3,
  "name": "Jev",
  "version": "2.0.4",
  "description": "Drive the tab you're on with TypeSafe Jev, or highlight text and ask it yes/no, pick-one and rating questions. Unofficial.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Jev",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "bg/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/snapshot.js", "content/overlay.js", "content/executor.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Open the Jev panel"
    }
  },
  "permissions": ["storage", "sidePanel", "contextMenus", "tabs", "scripting", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
