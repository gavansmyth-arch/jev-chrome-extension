{
  "manifest_version": 3,
  "name": "Jev",
  "version": "1.0.0",
  "description": "Highlight any text and get instant yes/no, pick-one and rating answers from TypeSafe Jev.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Jev",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://api.typesafe.ai/*"]
}
